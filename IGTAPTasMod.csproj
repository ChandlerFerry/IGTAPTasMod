<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>IGTAPTasMod</AssemblyName>
    <RootNamespace>IGTAPTasMod</RootNamespace>
    <GameRoot>C:\Users\deafwave\Downloads\IGTAP_Real</GameRoot>
    <ManagedDir>$(GameRoot)\IGTAPfullGame_Data\Managed</ManagedDir>
    <BepInExDir>$(GameRoot)\BepInEx\core</BepInExDir>
    <PluginDir>$(GameRoot)\BepInEx\plugins</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The offline engine host builds its own assemblies (including a rewritten Assembly-CSharp). -->
    <None Remove="enginesim\**" />
    <Compile Remove="enginesim\**\*.cs" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(ManagedDir)\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Optimize tab launches the offline solver from this repo (build it: enginesim\Cli, Release). -->
    <AssemblyMetadata Include="EngineSimExe" Value="$(MSBuildProjectDirectory)\enginesim\Cli\bin\Release\net10.0\IGTAP.EngineSim.exe" />
  </ItemGroup>

  <Target Name="BuildWebStudio" BeforeTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\web" Condition="!Exists('$(MSBuildProjectDirectory)\web\node_modules\next\package.json')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\web" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(PluginDir)" />
    <RemoveDir Directories="$(PluginDir)\IGTAPTasWeb" />
    <MakeDir Directories="$(PluginDir)\IGTAPTasWeb" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(PluginDir)\IGTAPTasMod.dll"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
    <ItemGroup>
      <WebStudioFiles Include="$(MSBuildProjectDirectory)\web\out\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebStudioFiles)"
          DestinationFolder="$(PluginDir)\IGTAPTasWeb\%(RecursiveDir)"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed $(TargetPath) to $(PluginDir)\IGTAPTasMod.dll" />
  </Target>
</Project>
