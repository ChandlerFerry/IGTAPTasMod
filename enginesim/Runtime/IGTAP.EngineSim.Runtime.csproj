<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IGTAP.EngineSim.Runtime</AssemblyName>
    <RootNamespace>IGTAP.EngineSim</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameManaged>$(IgtapGame)\IGTAPfullGame_Data\Managed</GameManaged>
    <RetargetedGame>$(MSBuildThisFileDirectory)..\obj\game\Assembly-CSharp.dll</RetargetedGame>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="IgtapRepo" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shim\IGTAP.UnityShim.csproj" />
    <ProjectReference Include="..\Box2D\IGTAP.Box2D.csproj" />
    <ProjectReference Include="..\Prep\IGTAP.EngineSim.Prep.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(RetargetedGame)" Private="true" />
  </ItemGroup>

  <!-- Prep's and the shim's paths from MSBuild: -o builds (the pre-commit check) have no bin/Release copies. -->
  <Target Name="EngineTools">
    <MSBuild Projects="..\Prep\IGTAP.EngineSim.Prep.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="PrepDll" />
    </MSBuild>
    <MSBuild Projects="..\Shim\IGTAP.UnityShim.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="ShimDll" />
    </MSBuild>
  </Target>

  <Target Name="RetargetGame" AfterTargets="ResolveProjectReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="EngineTools"
          Inputs="$(GameManaged)\Assembly-CSharp.dll;..\cuts.txt;..\hooks.txt;..\static-allow.txt;$(ShimDll);$(PrepDll)"
          Outputs="$(RetargetedGame)">
    <Exec Command="dotnet &quot;$(PrepDll)&quot; retarget &quot;$(GameManaged)&quot; &quot;$(MSBuildThisFileDirectory)..\obj\game&quot; &quot;$(MSBuildThisFileDirectory)..\cuts.txt&quot; &quot;$(MSBuildThisFileDirectory)..\hooks.txt&quot; &quot;$(ShimDll)&quot; &quot;$(MSBuildThisFileDirectory)..\static-allow.txt&quot;" />
  </Target>
</Project>
