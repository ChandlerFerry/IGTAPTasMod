<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IGTAP.EngineSim</AssemblyName>
    <RootNamespace>IGTAP.EngineSim.Cli</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>

    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="57982058496" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runtime\IGTAP.EngineSim.Runtime.csproj" />
    <Reference Include="Assembly-CSharp" HintPath="..\obj\game\Assembly-CSharp.dll" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="forced-paths.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="searchbench-grafts.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\techs.json" Link="techs.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\labmaps\*.json" Link="labmaps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="StampCommit" BeforeTargets="BeforeBuild">
    <Exec Command="git describe --always --dirty" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="EngineCommit" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="EngineCommit" Value="$(EngineCommit)" />
    </ItemGroup>
  </Target>
</Project>
