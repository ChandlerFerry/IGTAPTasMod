<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IGTAP.UnityShim</AssemblyName>
    <RootNamespace>UnityEngine</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>

    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0414;CS0618;CS0649;CS0660;CS0661;CS1591;CS8981;CS0628</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prep\IGTAP.EngineSim.Prep.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="MonoFloatSemantics" AfterTargets="CoreCompile" BeforeTargets="CopyFilesToOutputDirectory">
    <!-- Prep's own output, wherever -o or the configuration put it (a clean checkout has no bin\Release copy to run). -->
    <MSBuild Projects="..\Prep\IGTAP.EngineSim.Prep.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="PrepDll" />
    </MSBuild>
    <Exec Command="dotnet &quot;$(PrepDll)&quot; monofloat &quot;@(IntermediateAssembly->'%(FullPath)')&quot; UnityEngine.Vector2 UnityEngine.Vector3 UnityEngine.Rect UnityEngine.Color UnityEngine.Mathf UnityEngine.Quaternion" />
  </Target>
</Project>
